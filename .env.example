# عام — يصل إلى المتصفح
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# خادم فقط — لا تضع NEXT_PUBLIC_ أمام أي منها
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Bunny Stream — اختياري. بدونها يختفي خيار الرفع إلى Bunny من اللوحة
# المكتبة ومفتاحها من: Bunny ← Stream ← Library ← API
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# نطاق التسليم، مثل: vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_CDN_HOSTNAME=
# مفتاح توثيق الروابط من: Library ← Security ← Token Authentication
BUNNY_STREAM_TOKEN_KEY=
